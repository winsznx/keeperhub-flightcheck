# KeeperHub Flightcheck: copy to .env and fill in.
# .env is gitignored. Never paste these values into chat, a terminal echo, or an issue.

# ---------------------------------------------------------------------------
# REQUIRED for every user of this template
# ---------------------------------------------------------------------------

# Organization API key from app.keeperhub.com -> Settings -> API Keys -> Organisation tab.
# MUST start with kh_. A wfb_ key is a *user* key for webhook triggers and will not work
# here; Flightcheck diagnoses that mistake by name rather than returning a bare 401.
KEEPERHUB_API_KEY=kh_...

# ---------------------------------------------------------------------------
# OPTIONAL: sane defaults are compiled in, override only if you know why
# ---------------------------------------------------------------------------

# Target chain. Base Sepolia only in v1. Testnet is enforced regardless of this value.
FLIGHTCHECK_CHAIN_ID=84532

# Independent verification RPC. Flightcheck re-fetches the receipt and logs from a public
# node so a successful run never rests on KeeperHub's own reporting alone.
FLIGHTCHECK_RPC_URL=https://sepolia.base.org

# ---------------------------------------------------------------------------
# MAINTAINER-ONLY: NOT part of the onboarding flow
# ---------------------------------------------------------------------------
# Used exactly once, by the project maintainer, to deploy the canonical canary in Phase 1.
# A fresh user of this template does NOT deploy a contract and does NOT need this variable.
# The canary address, chainId, runtime bytecode hash and ABI version are pinned in config.
DEPLOYER_PRIVATE_KEY=
